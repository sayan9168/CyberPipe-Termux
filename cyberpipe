#!/data/data/com.termux/files/usr/bin/bash

# CyberPipe Main Launcher
# Non-root Termux Cybersecurity Pipeline Tool
# Author: Sayan Mahata (@sayan9168)

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
NC='\033[0m'

CYBERPIPE_HOME="${HOME}/CyberPipe-Termux"
RESULTS_DIR="${HOME}/CyberPipe-Results"
LOG_DIR="${CYBERPIPE_HOME}/logs"
TOOLS_DIR="${HOME}/tools"

mkdir -p "$RESULTS_DIR" "$LOG_DIR" 2>/dev/null || true

banner() {
    clear
    echo -e "${CYAN}"
    cat << "EOF"
   ______      __              ____  _            
  / ____/_  __/ /_  ___  _____/ __ \(_)___  ___  
 / /   / / / / __ \/ _ \/ ___/ /_/ / / __ \/ _ \ 
/ /___/ /_/ / /_/ /  __/ /  / ____/ / /_/ /  __/ 
\____/\__, /_.___/\___/_/  /_/   /_/ .___/\___/  
     /____/                       /_/            
EOF
    echo -e "${NC}"
    echo -e "${YELLOW}  Non-Root Termux | All Tools Pipeline${NC}"
    echo -e "${RED}  ★ Educational & Authorized Use Only ★${NC}"
    echo ""
}

pause() {
    echo ""
    read -p "Press Enter to continue..."
}

check_tool() {
    if command -v "$1" >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} $1"
        return 0
    else
        echo -e "${RED}✗${NC} $1 (not found)"
        return 1
    fi
}

show_status() {
    banner
    echo -e "${BLUE}=== Installed Tools Status ===${NC}"
    echo ""
    check_tool nmap
    check_tool hydra
    check_tool john
    check_tool sqlmap || check_tool python
    check_tool subfinder
    check_tool amass
    check_tool ffuf
    check_tool dirsearch || [ -f "$TOOLS_DIR/dirsearch/dirsearch.py" ]
    check_tool whatweb
    echo ""
    pause
}

network_menu() {
    while true; do
        banner
        echo -e "${PURPLE}=== Network Scanning ===${NC}"
        echo "1) Nmap Quick Scan (TCP Connect - non-root safe)"
        echo "2) Nmap Full Port Scan"
        echo "3) Nmap Service Detection"
        echo "4) WhatWeb (Technology Detection)"
        echo "5) Nikto Web Server Scan"
        echo "0) Back"
        echo ""
        read -p "Choice: " ch
        case $ch in
            1)
                read -p "Target IP/Domain: " target
                nmap -sT -Pn -T4 --top-ports 1000 "$target" | tee "$RESULTS_DIR/nmap_quick_$(date +%F_%H%M).txt"
                pause
                ;;
            2)
                read -p "Target IP/Domain: " target
                nmap -sT -Pn -p- -T4 "$target" | tee "$RESULTS_DIR/nmap_full_$(date +%F_%H%M).txt"
                pause
                ;;
            3)
                read -p "Target IP/Domain: " target
                nmap -sT -Pn -sV -T4 "$target" | tee "$RESULTS_DIR/nmap_service_$(date +%F_%H%M).txt"
                pause
                ;;
            4)
                if command -v whatweb >/dev/null 2>&1; then
                    read -p "URL: " url
                    whatweb "$url" | tee "$RESULTS_DIR/whatweb_$(date +%F_%H%M).txt"
                else
                    echo "whatweb not installed. Install with: pkg install whatweb"
                fi
                pause
                ;;
            5)
                if command -v nikto >/dev/null 2>&1; then
                    read -p "URL: " url
                    nikto -h "$url" | tee "$RESULTS_DIR/nikto_$(date +%F_%H%M).txt"
                else
                    echo "nikto not installed."
                fi
                pause
                ;;
            0) return ;;
            *) echo "Invalid" ;;
        esac
    done
}

web_menu() {
    while true; do
        banner
        echo -e "${PURPLE}=== Web Application Testing ===${NC}"
        echo "1) SQLMap (SQL Injection)"
        echo "2) Dirsearch (Directory Bruteforce)"
        echo "3) FFUF (Fuzzing)"
        echo "4) Gobuster (if available)"
        echo "0) Back"
        echo ""
        read -p "Choice: " ch
        case $ch in
            1)
                if [ -f "$TOOLS_DIR/sqlmap/sqlmap.py" ] || command -v sqlmap >/dev/null 2>&1; then
                    read -p "Target URL (with parameter): " url
                    python "$TOOLS_DIR/sqlmap/sqlmap.py" -u "$url" --batch --random-agent 2>/dev/null || sqlmap -u "$url" --batch
                else
                    echo "SQLMap not found. Run install.sh again."
                fi
                pause
                ;;
            2)
                if [ -f "$TOOLS_DIR/dirsearch/dirsearch.py" ]; then
                    read -p "Target URL: " url
                    python "$TOOLS_DIR/dirsearch/dirsearch.py" -u "$url" -e php,html,js,txt | tee "$RESULTS_DIR/dirsearch_$(date +%F_%H%M).txt"
                else
                    echo "Dirsearch not found."
                fi
                pause
                ;;
            3)
                if command -v ffuf >/dev/null 2>&1; then
                    read -p "URL (use FUZZ keyword): " url
                    read -p "Wordlist path (or press enter for common): " wl
                    wl=${wl:-/data/data/com.termux/files/usr/share/wordlists/dirb/common.txt}
                    ffuf -u "$url" -w "$wl" | tee "$RESULTS_DIR/ffuf_$(date +%F_%H%M).txt"
                else
                    echo "ffuf not found."
                fi
                pause
                ;;
            4)
                if command -v gobuster >/dev/null 2>&1; then
                    read -p "URL: " url
                    gobuster dir -u "$url" -w /data/data/com.termux/files/usr/share/wordlists/dirb/common.txt
                else
                    echo "gobuster not installed."
                fi
                pause
                ;;
            0) return ;;
            *) echo "Invalid" ;;
        esac
    done
}

recon_menu() {
    while true; do
        banner
        echo -e "${PURPLE}=== Recon & OSINT ===${NC}"
        echo "1) Subfinder (Subdomain Enumeration)"
        echo "2) Amass (Advanced Subdomain)"
        echo "3) theHarvester"
        echo "4) Sherlock (Username Search)"
        echo "5) Holehe (Email OSINT)"
        echo "0) Back"
        echo ""
        read -p "Choice: " ch
        case $ch in
            1)
                if command -v subfinder >/dev/null 2>&1; then
                    read -p "Domain: " domain
                    subfinder -d "$domain" -o "$RESULTS_DIR/subfinder_${domain}_$(date +%F).txt"
                    cat "$RESULTS_DIR/subfinder_${domain}_$(date +%F).txt"
                else
                    echo "subfinder not found. Install via go or re-run install."
                fi
                pause
                ;;
            2)
                if command -v amass >/dev/null 2>&1; then
                    read -p "Domain: " domain
                    amass enum -d "$domain" -o "$RESULTS_DIR/amass_${domain}_$(date +%F).txt"
                else
                    echo "amass not found."
                fi
                pause
                ;;
            3)
                if [ -d "$TOOLS_DIR/theHarvester" ]; then
                    read -p "Domain: " domain
                    cd "$TOOLS_DIR/theHarvester"
                    python theHarvester.py -d "$domain" -b all | tee "$RESULTS_DIR/harvester_${domain}_$(date +%F).txt"
                    cd - > /dev/null
                else
                    echo "theHarvester not found."
                fi
                pause
                ;;
            4)
                if [ -d "$TOOLS_DIR/sherlock" ]; then
                    read -p "Username: " user
                    cd "$TOOLS_DIR/sherlock"
                    python sherlock "$user" | tee "$RESULTS_DIR/sherlock_${user}_$(date +%F).txt"
                    cd - > /dev/null
                else
                    echo "sherlock not found."
                fi
                pause
                ;;
            5)
                if command -v holehe >/dev/null 2>&1; then
                    read -p "Email: " email
                    holehe "$email" | tee "$RESULTS_DIR/holehe_$(date +%F).txt"
                else
                    echo "holehe not found. pip install holehe"
                fi
                pause
                ;;
            0) return ;;
            *) echo "Invalid" ;;
        esac
    done
}

password_menu() {
    while true; do
        banner
        echo -e "${PURPLE}=== Password Attacks ===${NC}"
        echo "1) Hydra (Network Login Crack)"
        echo "2) John the Ripper"
        echo "3) Generate Wordlist (Cupp style simple)"
        echo "0) Back"
        echo ""
        read -p "Choice: " ch
        case $ch in
            1)
                echo "Example: hydra -l admin -P wordlist.txt ftp://target"
                read -p "Full hydra command (or press enter to skip): " cmd
                if [ -n "$cmd" ]; then
                    eval "$cmd" | tee "$RESULTS_DIR/hydra_$(date +%F_%H%M).txt"
                fi
                pause
                ;;
            2)
                if command -v john >/dev/null 2>&1; then
                    read -p "Hash file path: " hashfile
                    john "$hashfile"
                else
                    echo "john not found."
                fi
                pause
                ;;
            3)
                read -p "Base word: " base
                echo "${base}" > "$RESULTS_DIR/wordlist.txt"
                echo "${base}123" >> "$RESULTS_DIR/wordlist.txt"
                echo "${base}@123" >> "$RESULTS_DIR/wordlist.txt"
                echo "${base}2024" >> "$RESULTS_DIR/wordlist.txt"
                echo "${base}2025" >> "$RESULTS_DIR/wordlist.txt"
                echo "${base}2026" >> "$RESULTS_DIR/wordlist.txt"
                echo "Simple wordlist created at $RESULTS_DIR/wordlist.txt"
                pause
                ;;
            0) return ;;
            *) echo "Invalid" ;;
        esac
    done
}

pipeline_menu() {
    while true; do
        banner
        echo -e "${PURPLE}=== Pipeline Mode ===${NC}"
        echo "1) Domain Full Recon Pipeline"
        echo "2) Web App Quick Assessment"
        echo "3) Custom Pipeline (coming soon)"
        echo "0) Back"
        echo ""
        read -p "Choice: " ch
        case $ch in
            1)
                read -p "Target Domain: " domain
                echo -e "${BLUE}[*] Starting Domain Full Recon Pipeline for $domain${NC}"
                mkdir -p "$RESULTS_DIR/pipeline_${domain}"
                
                echo "[1/4] Subdomain enumeration with Subfinder..."
                if command -v subfinder >/dev/null 2>&1; then
                    subfinder -d "$domain" -o "$RESULTS_DIR/pipeline_${domain}/subdomains.txt"
                else
                    echo "$domain" > "$RESULTS_DIR/pipeline_${domain}/subdomains.txt"
                fi
                
                echo "[2/4] Port scanning top targets..."
                head -n 5 "$RESULTS_DIR/pipeline_${domain}/subdomains.txt" | while read host; do
                    nmap -sT -Pn -T4 --top-ports 100 "$host" >> "$RESULTS_DIR/pipeline_${domain}/nmap.txt" 2>/dev/null || true
                done
                
                echo "[3/4] Technology detection..."
                if command -v whatweb >/dev/null 2>&1; then
                    whatweb "http://$domain" > "$RESULTS_DIR/pipeline_${domain}/whatweb.txt" 2>/dev/null || true
                fi
                
                echo "[4/4] Directory discovery on main domain..."
                if [ -f "$TOOLS_DIR/dirsearch/dirsearch.py" ]; then
                    python "$TOOLS_DIR/dirsearch/dirsearch.py" -u "http://$domain" -e php,html,js --quiet -o "$RESULTS_DIR/pipeline_${domain}/dirs.txt" 2>/dev/null || true
                fi
                
                echo -e "${GREEN}[+] Pipeline finished. Results in $RESULTS_DIR/pipeline_${domain}/${NC}"
                pause
                ;;
            2)
                read -p "Target URL (http/https): " url
                echo -e "${BLUE}[*] Web App Quick Assessment${NC}"
                mkdir -p "$RESULTS_DIR/webpipe_$(date +%F_%H%M)"
                OUT="$RESULTS_DIR/webpipe_$(date +%F_%H%M)"
                
                if command -v whatweb >/dev/null 2>&1; then
                    whatweb "$url" > "$OUT/tech.txt"
                fi
                if [ -f "$TOOLS_DIR/dirsearch/dirsearch.py" ]; then
                    python "$TOOLS_DIR/dirsearch/dirsearch.py" -u "$url" -e php,html,js,txt -o "$OUT/dirs.txt" 2>/dev/null || true
                fi
                echo -e "${GREEN}[+] Done. Check $OUT${NC}"
                pause
                ;;
            3)
                echo "Custom pipelines can be added in pipelines/ folder."
                pause
                ;;
            0) return ;;
            *) echo "Invalid" ;;
        esac
    done
}

nethunter_menu() {
    banner
    echo -e "${PURPLE}=== Kali NetHunter Rootless ===${NC}"
    echo "1) Install proot-distro + NetHunter (if not installed)"
    echo "2) Login to NetHunter"
    echo "0) Back"
    echo ""
    read -p "Choice: " ch
    case $ch in
        1)
            pkg install proot-distro -y
            echo "Now run: proot-distro install nethunter"
            echo "Then: proot-distro login nethunter"
            pause
            ;;
        2)
            proot-distro login nethunter || echo "NetHunter not installed yet."
            ;;
        0) return ;;
    esac
}

main_menu() {
    while true; do
        banner
        echo -e "${GREEN}1)${NC} Network Scanning"
        echo -e "${GREEN}2)${NC} Web Application Testing"
        echo -e "${GREEN}3)${NC} Recon & OSINT"
        echo -e "${GREEN}4)${NC} Password Attacks"
        echo -e "${GREEN}5)${NC} Pipeline Mode (Recommended)"
        echo -e "${GREEN}6)${NC} Tool Status"
        echo -e "${GREEN}7)${NC} Kali NetHunter Rootless"
        echo -e "${GREEN}8)${NC} Update CyberPipe"
        echo -e "${GREEN}0)${NC} Exit"
        echo ""
        read -p "Select option: " choice
        case $choice in
            1) network_menu ;;
            2) web_menu ;;
            3) recon_menu ;;
            4) password_menu ;;
            5) pipeline_menu ;;
            6) show_status ;;
            7) nethunter_menu ;;
            8)
                cd "$CYBERPIPE_HOME" 2>/dev/null || cd ~/CyberPipe-Termux
                git pull origin main 2>/dev/null || echo "Update failed or not a git repo."
                pause
                ;;
            0)
                echo -e "${YELLOW}Stay ethical. Goodbye!${NC}"
                exit 0
                ;;
            *) echo "Invalid option" ;;
        esac
    done
}

# Entry point
if [ "$1" = "--install" ]; then
    bash "$(dirname "$0")/install.sh"
elif [ "$1" = "--help" ]; then
    echo "Usage: cyberpipe [--install] [--help]"
else
    main_menu
fi
